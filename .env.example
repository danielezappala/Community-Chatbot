# Google Sheets API Configuration
# Copy this file to .env and fill in your credentials

# Google Sheets Configuration
# Percorso assoluto al file credentials.json scaricato da Google Cloud Console
GOOGLE_SHEETS_CREDENTIALS_JSON=/percorso/assoluto/alla/tua/credentials.json
# ID del tuo foglio Google Sheets (lo trovi nell'URL)
GOOGLE_SHEETS_SPREADSHEET_ID=il_tuo_spreadsheet_id_qui

# Telegram Bot Configuration
# Token del tuo bot Telegram ottenuto da @BotFather
TELEGRAM_BOT_TOKEN=il_tuo_telegram_bot_token_qui
